# Generate both values with a password manager or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# This key encrypts every user's saved DeepSeek key. Do not change it after deployment.
LLM_CONFIG_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
PORT=3001
# Comma-separated allowed browser origins. Empty allows any origin (development default).
# Production example: https://campusmind.example.com
CORS_ORIGINS=
# Parallel resource indexing jobs (1-8). Lower for small servers.
RESOURCE_INDEX_CONCURRENCY=2
# Required in production. Local development can read deploy/postgres/.env instead.
# Compose supplies this automatically from deploy/postgres/.env.
DATABASE_URL=
# Optional Redis cache. Development also reads deploy/redis/.env when present.
# Compose supplies REDIS_URL automatically. false always disables this cache.
REDIS_URL=
REDIS_ENABLED=
REDIS_CACHE_TTL_SECONDS=600
REDIS_TIMEOUT_MS=200
# Use distinct prefixes for different applications/databases sharing one Redis.
REDIS_KEY_PREFIX=campusmind:cache:v1
# Keep this model name configurable so the platform can migrate providers later.
DEEPSEEK_MODEL=deepseek-chat
# Optional LiteLLM gateway. Leave both empty to call DeepSeek directly.
# Root URL only (no /v1). With the Compose overlay these are injected automatically.
LLM_GATEWAY_URL=
LLM_GATEWAY_MASTER_KEY=
# Limits apply to each user's gateway key; requests within one Agent run each count.
LLM_GATEWAY_RPM=60
LLM_GATEWAY_TPM=100000
LLM_TIMEOUT_MS=60000
# Optional personal facts and historical conversation summaries, in the same database.
# With no embedding settings memory is inactive; MEMORY_ENABLED=true requires all three.
# The provider base URL must include its API prefix, but NOT /embeddings.
MEMORY_ENABLED=
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_DIMENSIONS=1024
# Local CPU models may need extra time for the first load (e.g. 60000).
MEMORY_EMBEDDING_TIMEOUT_MS=8000
MEMORY_MIN_SIMILARITY=0.5
MEMORY_SUMMARY_MIN_MESSAGES=6
# auto: extract stable learning facts; explicit: only when asked to remember;
# off: pause new extraction and queued jobs, while retaining recall and management.
MEMORY_WRITE_MODE=auto
# Course-library RAG: inherits MEMORY_EMBEDDING_* when RAG_* values are empty.
# Independent of MEMORY_ENABLED. false keeps keyword retrieval only.
RAG_VECTOR_ENABLED=
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIMENSIONS=
RAG_EMBEDDING_TIMEOUT_MS=
# rules: no model calls; model: opt-in using the user's chat provider; off: disable.
RAG_QUERY_REWRITE=rules
# Optional Jina/Cohere-compatible reranker. Leave disabled until evaluated.
# Full endpoint, e.g. http://127.0.0.1:8001/v1/rerank. Separate from embedding.
RAG_RERANK_ENABLED=false
RAG_RERANK_URL=
RAG_RERANK_MODEL=
RAG_RERANK_API_KEY=
RAG_RERANK_TIMEOUT_MS=3000
# Required only for the Agent PDF export. On Ubuntu install fonts-droid-fallback,
# then use: /usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf
PDF_FONT_PATH=
# First server start will create this administrator, or promote an existing matching student ID.
# Keep ADMIN_PASSWORD only in the server .env; never commit it.
ADMIN_STUDENT_ID=replace-with-8-digit-admin-id
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=CampusMind 管理员
ADMIN_COLLEGE=CampusMind 平台
# Optional: enable phone verification login and password reset with Alibaba Cloud SMS.
# Create a RAM user with SMS permissions, then use an approved signature and a template
# containing a ${code} variable. Keep these values only in server/.env.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
