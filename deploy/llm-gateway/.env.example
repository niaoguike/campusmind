# main-stable is for evaluation. After validation, pin a release tag or image digest.
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
# Generate three DIFFERENT random values; never commit the populated .env.
LITELLM_MASTER_KEY=sk-replace-with-random-hex
# Keep this stable once PostgreSQL contains gateway data.
LITELLM_SALT_KEY=sk-replace-with-different-random-hex
# Use hex to avoid special-character escaping in DATABASE_URL.
LITELLM_POSTGRES_PASSWORD=replace-with-different-random-hex
