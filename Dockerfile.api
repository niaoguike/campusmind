FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-venv \
  && rm -rf /var/lib/apt/lists/*

COPY server/package*.json ./
RUN npm ci --omit=dev

COPY server/requirements.txt ./
RUN python3 -m venv /opt/campusmind-venv \
  && /opt/campusmind-venv/bin/pip install --no-cache-dir -r requirements.txt

COPY server/ ./

ENV PYTHON=/opt/campusmind-venv/bin/python
ENV NODE_ENV=production

EXPOSE 3001
CMD ["npm", "start"]
